{
  "log": {
    "level": "info",
    "format": "text"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "read_timeout": "30s",
    "read_header_timeout": "5s",
    "write_timeout": "30s",
    "idle_timeout": "2m",
    "transfer_rate": 65536
  },
  "database": {
    "name": "app",
    "user": "app",
    "options": {
      "sslmode": "disable"
    }
  },
  "storage": {
    "container": "mikoshi",
    "options": {
      "region": "us-east-1"
    }
  },
  "messaging": {
    "source": "mikoshi"
  },
  "nats": {
    "name": "mikoshi",
    "stream": "MIKOSHI",
    "prefix": "mikoshi",
    "owner": true,
    "max_age": "168h"
  },
  "reads": {
    "default_size": 20,
    "max_size": 100
  },
  "uploads": {
    "lifetime": "24h",
    "max_append_size": 4194304
  },
  "sweep": {
    "expired_uploads": {
      "interval": "1m",
      "budget": 100
    },
    "pending_blobs": {
      "interval": "5m",
      "budget": 100,
      "stale_age": "1h"
    },
    "orphan_blobs": {
      "interval": "15m",
      "budget": 100,
      "stale_age": "24h"
    },
    "outbox_messages": {
      "interval": "5m",
      "budget": 500,
      "age": "168h"
    },
    "inbox_messages": {
      "interval": "5m",
      "budget": 500,
      "age": "168h"
    }
  },
  "shutdown_timeout": "10s"
}
